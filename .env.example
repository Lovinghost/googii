MODEL_PROVIDER=openai
MODEL_NAME=gpt-4.1-mini
OPENAI_API_KEY=

# Every workspace received from the Go gateway must resolve inside this directory.
# For the current local integration, a typical value is D:\projects.
WORKSPACE_ROOT=D:\projects
DATABASE_PATH=storage/checkpoints.sqlite

SANDBOX_IMAGE=python:3.12-slim
SANDBOX_CPUS=1
SANDBOX_MEMORY=512m
SANDBOX_PIDS_LIMIT=256
COMMAND_TIMEOUT_MAX=300

AGENT_MAX_ITERATIONS=20
MAX_TOOL_CALLS=40
MAX_NO_PROGRESS_STEPS=3
MAX_WALL_TIME_SECONDS=900
MODEL_CONTEXT_LIMIT=32000
RECENT_MESSAGE_LIMIT=10
TOOL_INLINE_MAX_BYTES=8192
EVENT_HISTORY_LIMIT=1000
